{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "avery-website",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
