# Copy this file to .env for local development. Never commit the real .env file.
# These are consumed by Cloudflare Pages Functions (functions/) and/or a
# separate backend service — see docs/BACKEND_API_SETUP.md.

# --- Supabase -----------------------------------------------------------
# Project URL and anon key: safe to expose to the browser.
# Find both under Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service role key: server-only, NEVER expose to the client or commit it.
# Only set this as a secret on your backend / Cloudflare Pages Function env.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---------------------------------------------------------------
# See docs/STRIPE_INTEGRATION.md for the full setup guide.
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Site -------------------------------------------------------------
PUBLIC_SITE_URL=https://avery-website.pages.dev
